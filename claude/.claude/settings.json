{
  "model": "opus",
  "preferredNotifChannel": "notifications_disabled",
  "tui": "fullscreen",
  "permissions": {
    "defaultMode": "auto"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/ruff.sh\"",
            "statusMessage": "Running ruff",
            "timeout": 60
          }
        ]
      }
    ]
  },
  "effortLevel": "xhigh",
  "outputStyle": "Concise",
  "statusLine": {
    "type": "command",
    "command": "bash \"$HOME/.claude/statusline-command.sh\""
  }
}
